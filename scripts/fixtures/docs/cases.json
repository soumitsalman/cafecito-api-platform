{
  "description": "Negative fixtures: each case must produce a failing check. Do not use these as live docs.",
  "cases": [
    {
      "id": "examples-unknown-path",
      "check": "examples",
      "dir": "examples-unknown-path",
      "expect": "not in gateway OpenAPI"
    },
    {
      "id": "examples-unknown-query",
      "check": "examples",
      "dir": "examples-unknown-query",
      "expect": "query parameter made_up_filter"
    },
    {
      "id": "examples-envelope",
      "check": "examples",
      "dir": "examples-envelope",
      "expect": "collection pagination missing num_results"
    },
    {
      "id": "examples-bruno-path",
      "check": "examples",
      "dir": "examples-bruno-path",
      "expect": "not in gateway OpenAPI"
    },
    {
      "id": "examples-mcp-tool",
      "check": "examples",
      "dir": "examples-mcp-tool",
      "expect": "MCP tool inventWidgets is not exported"
    },
    {
      "id": "terms-forbidden",
      "check": "terms",
      "dir": "terms-forbidden",
      "expect": "forbidden public term (cupboard)"
    },
    {
      "id": "terms-stale-path",
      "check": "terms",
      "dir": "terms-stale-path",
      "expect": "stale public path"
    },
    {
      "id": "lifecycle-missing",
      "check": "lifecycle",
      "dir": "lifecycle-missing",
      "expect": "missing lifecycle field"
    },
    {
      "id": "lifecycle-stale-date",
