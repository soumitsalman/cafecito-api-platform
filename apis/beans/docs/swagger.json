                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "router.ArticleCollectionResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "pagination"
            ],
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/router.ArticleDocument"
                    }
                },
                "meta": {
                    "$ref": "#/definitions/router.ResponseMeta"
                },
                "pagination": {
                    "$ref": "#/definitions/router.Pagination"
                }
            }
        },
        "router.ArticleDetail": {
            "type": "object",
            "properties": {
                "author": {
                    "type": "string"
                },
                "categories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "content": {
                    "type": "string"
                },
                "content_type": {
                    "type": "string",
                    "enum": [
                        "blog",
                        "contract",
                        "earnings_report",
                        "enforcement_action",
                        "financial_report",
                        "lawsuit",
                        "news",
                        "official_statement",
                        "podcast",
                        "post",
                        "press_release",
                        "research_paper",
                        "site",
                        "technical_documentation",
                        "whitepaper"
                    ]
                },
                "entities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string",
                    "format": "uuid"
                },
                "image_url": {
                    "type": "string"
                },
